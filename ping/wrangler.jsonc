// Cloudflare-Worker "kennzeichen-ping": schaut jede Minute, ob das Portal antwortet,
// und startet den Waechter auf GitHub (workflow_dispatch). Deploy: siehe README.md im Repo.
{
  "name": "kennzeichen-ping",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "STAND", "id": "9f1bf696e472417fb0ce777d8860d529" }],
  "vars": {
    "REPO": "zekrom-cmd/kennzeichen-waechter",
    "WORKFLOW": "waechter.yml",
    "TAKT_MIN": "5",
    // Freigaben kommen taeglich gegen 7:00 -> Waechter laeuft dann in Dauerschleife (Berlin-Zeit)
    "MORGEN": "06:50-07:30",
    // Wunsch-Kennzeichen, jede Minute einzeln geprueft (Buchstaben+Ziffern, kommagetrennt)
    "WUNSCH": "XX3",
    // Wuensche des Bruders - Push zusaetzlich an Secret NTFY_TOPIC_BRUDER (falls gesetzt)
    "WUNSCH_BRUDER": "GG2"
  }
  // Secret GITHUB_TOKEN (fine-grained, nur dieses Repo, Actions: Read and write)
  // traegt der Nutzer selbst ein: wrangler secret put GITHUB_TOKEN
  // Secret NTFY_TOPIC: dasselbe Thema wie beim Waechter (GitHub-Secret NTFY_TOPIC)
}
